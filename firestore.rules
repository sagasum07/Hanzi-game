rules_version = '2';

// Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 "게시"하세요.
//
// users/{uid}            학습 기록 (본인만 읽기/쓰기)
// profiles/{uid}         공개 프로필: 닉네임 + 고유 번호 (로그인한 사용자 누구나 읽기, 본인만 쓰기)
// nicknames/{n_닉네임}    닉네임 점유 표시 → 같은 닉네임은 한 명만 (이미 있으면 만들 수 없음)
// userCodes/{8자리 번호}  고유 번호 점유 표시 → 같은 번호는 한 명만
// friendRequests/{보낸uid_받는uid}  친구 요청
// friendships/{작은uid_큰uid}       친구 관계 (요청을 받은 사람이 수락할 때만 생성)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function nicknameKey(nickname) {
      return 'n_' + nickname.lower();
    }

    // 두 명 중 내가 아닌 사람
    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // 이번 쓰기가 끝난 뒤의 내 프로필
    function myProfileAfter() {
      return getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // ---------- 학습 기록 ----------
    match /users/{uid} {
      allow read, write: if isMe(uid);
    }

    // ---------- 공개 프로필 ----------
    match /profiles/{uid} {
      allow read: if signedIn();

      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'userCode', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.userCode is string
        && request.resource.data.userCode.matches('^[0-9]{8}$')
        // 고유 번호는 한 번 정해지면 바뀌지 않음
        && (resource == null || request.resource.data.userCode == resource.data.userCode)
        // 닉네임과 고유 번호를 실제로 내가 점유하고 있어야 함
        && getAfter(/databases/$(database)/documents/nicknames/$(nicknameKey(request.resource.data.nickname))).data.uid == uid
        && getAfter(/databases/$(database)/documents/userCodes/$(request.resource.data.userCode)).data.uid == uid;

      allow delete: if isMe(uid);
    }

    // ---------- 닉네임 점유 (중복 방지) ----------
    match /nicknames/{key} {
      allow read: if signedIn();

      // 문서가 없을 때만 create 가 되므로, 이미 누가 쓰는 닉네임은 만들 수 없음
      // 내 프로필에 실제로 쓰는 닉네임만 점유 가능 (닉네임 사재기 방지)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key == nicknameKey(myProfileAfter().nickname);

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- 고유 번호 점유 (중복 방지) ----------
    match /userCodes/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && myProfileAfter().userCode == code;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- 친구 요청 ----------
    match /friendRequests/{requestId} {
      // 없는 문서를 확인하는 것도 허용 (이미 요청했는지 확인용)
      allow read: if signedIn()
        && (resource == null
          || resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to));

      // 보낸 사람은 취소, 받은 사람은 거절·수락 때 삭제
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---------- 친구 관계 ----------
    match /friendships/{pairId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);

      // 상대가 나에게 보낸 요청이 있을 때, 받은 사람(나)이 수락하면서 만듦
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/friendRequests/$(otherMember(request.resource.data.members) + '_' + request.auth.uid));

      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }
  }
}
